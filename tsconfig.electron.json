{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "electron/**/*.ts",
    "src/backgroundCommandWorker.ts",
    "src/backgroundReviewWorker.ts",
    "src/backgroundVerificationWorker.ts"
  ],
  "exclude": [
    "dist",
    "dist-electron",
    "node_modules",
    "src/**/*.test.ts"
  ]
}
