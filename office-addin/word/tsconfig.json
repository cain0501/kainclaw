{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ES2020", "DOM"],
    "types": ["office-js"],
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
